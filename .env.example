# Documentation only. Run python3 scripts/configure.py to generate .env.
# No default credentials are supplied. Configure API keys via set-secret.py.
AI_PROVIDER='openai'
OPENAI_MODEL='gpt-4o'
ANTHROPIC_MODEL=''
USER_DAILY_TOKEN_BUDGET='500000'
GLOBAL_DAILY_TOKEN_BUDGET='5000000'
# Governed feeds are opt-in. No source is mapped or shared by default.
FEEDS_ENABLED='false'
# Operator supplies FEEDS_SOURCES_FILE, FEEDS_STATE_FILE, FEEDS_DATABASE_URL and
# FEEDS_NOCODB_TOKEN privately after source/delegation review; see docs/engineering/GOVERNED-FEEDS.md.
